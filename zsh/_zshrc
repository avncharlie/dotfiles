# --- virtualenvwrapper (lazy) ---
export WORKON_HOME="$HOME/.virtualenvs"
_vwrapper_lazy_load() {
  unset -f workon mkvirtualenv rmvirtualenv mkproject cdvirtualenv cdproject 2>/dev/null
  VIRTUALENVWRAPPER_PYTHON="/usr/bin/python3"
  source /usr/local/bin/virtualenvwrapper.sh
}
workon()        { _vwrapper_lazy_load && workon "$@"; }
mkvirtualenv()  { _vwrapper_lazy_load && mkvirtualenv "$@"; }
rmvirtualenv()  { _vwrapper_lazy_load && rmvirtualenv "$@"; }
mkproject()     { _vwrapper_lazy_load && mkproject "$@"; }
cdvirtualenv()  { _vwrapper_lazy_load && cdvirtualenv "$@"; }
cdproject()     { _vwrapper_lazy_load && cdproject "$@"; }

# --- nvm (lazy) ---
export NVM_DIR="$HOME/.nvm"
_nvm_lazy_load() {
  unset -f nvm node npm pnpm yarn npx corepack 2>/dev/null
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
  [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
}
nvm()     { _nvm_lazy_load && nvm "$@"; }
node()    { _nvm_lazy_load && node "$@"; }
npm()     { _nvm_lazy_load && npm "$@"; }
pnpm()    { _nvm_lazy_load && pnpm "$@"; }
yarn()    { _nvm_lazy_load && yarn "$@"; }
npx()     { _nvm_lazy_load && npx "$@"; }
corepack() { _nvm_lazy_load && corepack "$@"; }

# --- temp directory helper ---
function mtd() {
  local target_dir="/tmp/"
  local name=$1
  if [ -z "$name" ]; then
    name=$(openssl rand -hex 16)
  fi
  local dir_path="${target_dir}${name}"
  local postfix=2
  while [ -d "$dir_path" ]; do
    name="${1}${postfix}"
    dir_path="${target_dir}${name}"
    ((postfix++))
  done
  mkdir "$dir_path"
  cd "$dir_path"
}

