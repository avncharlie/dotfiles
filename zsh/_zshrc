# --- key bindings ---
bindkey -v
bindkey '^h' autosuggest-accept
bindkey '^o' autosuggest-execute
bindkey '^F' fzf-history-widget
bindkey '^R' history-incremental-pattern-search-backward

# --- completion: menu select with highlight + shift-tab reverse ---
autoload -Uz compinit && compinit
zmodload zsh/complist
zstyle ':completion:*' menu select
# Colorize the completion list like `ls` (dirs, executables, symlinks, etc.).
export LS_COLORS='di=34:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;44'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Shift-Tab (back-tab) reverses through the menu. Use the terminfo entry so it
# works regardless of which terminal sends ^[[Z vs another sequence. Bound in
# both the main keymaps and the menuselect keymap.
bindkey "$terminfo[kcbt]" reverse-menu-complete
bindkey -M vicmd "$terminfo[kcbt]" reverse-menu-complete
bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete
# Vi-style hjkl navigation inside the menu.
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'j' vi-down-line-or-history

# --- case-insensitive tab completion ---
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- fzf (stable path across fzf versions) ---
