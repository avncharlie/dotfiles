{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["btw-opencode"],
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "clangd": {
      "command": ["clangd", "--background-index", "--clang-tidy", "--header-insertion=iwyu"],
      "extensions": [".c", ".cpp", ".h", ".hpp", ".cc", ".cxx"]
    }
  },
  "tools": {
    "websearch": true
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": { "provider": { "quantizations": ["fp8"], "data_collection": "deny", "require_parameters": true } }
        },
        "moonshotai/kimi-k2.7-code": {
          "options": { "provider": { "quantizations": ["int4"], "data_collection": "deny", "require_parameters": true } }
        },
        "deepseek/deepseek-v4-pro": {
          "options": { "provider": { "only": ["deepseek"] } }
        }
      }
    }
  }
}
